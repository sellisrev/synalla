{
  "name": "synalla",
  "version": "0.1.0",
  "private": true,
  "description": "Personal agents that exchange limited private facts and act only when interests align.",
  "license": "AGPL-3.0-only OR LicenseRef-Synalla-Commercial",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "test": "node --import ./tools/ts-resolve.mjs --test --test-timeout=120000 --test-force-exit \"test/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm test",
    "demo": "node examples/cold_start_demo.mjs",
    "test:mutation": "stryker run",
    "golden:record": "node tools/record-golden.mjs"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@types/node": "24.19.1",
    "typescript": "5.9.3"
  }
}
