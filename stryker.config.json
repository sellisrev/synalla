{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "node tools/mutation-test.mjs"
  },
  "mutate": [
    "src/**/*.ts",
    "!src/index.ts",
    "!src/kinds.ts",
    "!src/result.ts"
  ],
  "concurrency": 6,
  "timeoutMS": 20000,
  "reporters": [
    "clear-text",
    "json",
    "html",
    "progress"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": "always",
  "disableTypeChecks": "src/**/*.ts"
}
